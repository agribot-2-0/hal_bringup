<launch>
    <arg name="manual" default="true"/>

    <include file="$(find hal_inclinometer)/launch/hal_inclinometer.launch" />
    <include file="$(find hal_agribot_control)/launch/hal_agribot_control.launch" />
    <include file="$(find hal_hydrabox)/launch/hal_hydrabox.launch" />

    <group if="$(arg manual)">
        <include file="$(find hal_manual_control)/launch/hal_manual_control.launch" />
    </group>
</launch>
