<launch>
    <arg name="encoder_impulses_per_revolution" default="36" />

    <include file="$(find hal_agribot_control)/launch/hal_agribot_control.launch" >
        <arg name="encoder_impulses_per_revolution" value="$(arg encoder_impulses_per_revolution)"/>
    </include>
    <include file="$(find hal_hydrabox)/launch/hal_hydrabox.launch" />
    <include file="$(find hal_inclinometer)/launch/hal_inclinometer.launch" />
    <include file="$(find hal_mobile_app)/launch/hal_mobile_app.launch" />
</launch>
