<launch>
  <include file="$(find hal_agribot_control)/launch/hal_agribot_control.launch" />
  <include file="$(find hal_engine_monitoring)/launch/hal_engine_monitoring.launch" />
  <include file="$(find hal_hydrabox)/launch/hal_hydrabox_dual.launch" />
  <include file="$(find hal_bynav)/launch/hal_bynav.launch" />
  <include file="$(find hal_hydraulics_monitoring)/launch/hal_hydraulics_monitoring.launch" />
  <include file="$(find hal_inclinometer)/launch/hal_inclinometer.launch" />
  <include file="$(find hal_io_card)/launch/hal_io_card.launch" />
  <include if="$(env AGRIBOT_PERCEPTION_SENSORS)" file="$(find hal_lidar)/launch/hal_lidar.launch" />
  <include if="$(env AGRIBOT_PERCEPTION_SENSORS)" file="$(find hal_zed2)/launch/zed2.launch">
    <remap from="~cloud_registered" to="/agribot/obstacle_detection/front/3d/stereo_camera/point_cloud" />
  </include>
  <include file="$(find hal_lights)/launch/hal_lights.launch" />
  <include file="$(find hal_mobile_app)/launch/hal_mobile_app.launch" />
  <include file="$(find hal_rfid)/launch/hal_rfid.launch" />
  <include file="$(find hal_video_stream)/launch/hal_video_stream.launch" />
  <include file="$(find hal_weather_station)/launch/hal_weather_station.launch" />
  <include file="$(find hal_tool)/launch/hal_tool.launch" />
</launch>